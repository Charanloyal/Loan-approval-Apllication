# Environment variables for the loan approval prediction project
# Copy this file to .env and fill in your actual values

# Data paths
DATA_PATH=data/loan_prediction.csv
MODEL_PATH=models/
LOGS_PATH=logs/

# Model configuration
RANDOM_STATE=42
TEST_SIZE=0.2
CV_FOLDS=5

# API configuration (if deploying as web service)
FLASK_ENV=development
FLASK_PORT=5000
FLASK_DEBUG=True

# Logging configuration
LOG_LEVEL=INFO
